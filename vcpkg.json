{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mailspring-sync",
  "version": "1.0.0",
  "description": "Native sync engine for Mailspring email client",
  "dependencies": [
    {
      "name": "openssl",
      "version>=": "3.6.5"
    },
    {
      "name": "curl",
      "version>=": "8.23.0",
      "default-features": false,
      "features": ["openssl"]
    },
    {
      "name": "libxml2",
      "version>=": "2.15.4"
    },
    {
      "name": "zlib",
      "version>=": "1.3.2"
    },
    "icu",
    "libiconv",
    "tidy-html5",
    "ctemplate",
    "pthreads",
    "cyrus-sasl"
  ]
}
